# Copy to .env and fill in. .env is git-ignored.
#
# Everything below is optional. The AFML pipeline, the OpenBB data layer,
# the backtester and the Streamlit dashboard all run without any key set.
# These variables are only needed by the RAG and language-model helpers
# in analysis_engine/knowledge.py, utils/sanity_check.py and scripts/.

# Google AI Studio key, used by the Gemini embedding path in
# analysis_engine/knowledge.py and by utils/sanity_check.py.
GOOGLE_API_KEY=

# Google Cloud project used by the Vertex AI embedding path
# (analysis_engine/knowledge.py), scripts/check_llm.py and trade.sh.
# There is no default. scripts/check_llm.py and trade.sh both exit with a
# message when it is unset; analysis_engine/knowledge.py does not — it skips
# the Vertex branch silently and uses ChromaDB's default ONNX embeddings.
GCP_PROJECT_ID=

# Vertex AI region. Defaults to us-central1 when unset.
GCP_LOCATION=us-central1
